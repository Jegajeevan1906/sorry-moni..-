# Backend Server Port
PORT=3001

# Allowed Frontend Origin for CORS (optional, defaults to http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# WhatsApp Business Cloud API Credentials
# Obtain these from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temporary_access_token_here

# Recipient WhatsApp Number (E.164 without +)
WHATSAPP_RECIPIENT_NUMBER=918072935820

# Optional: Approved Template Name (if outside 24h customer service window)
# Leave blank to send standard text message within an active 24h session
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

